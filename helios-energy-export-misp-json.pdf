mestamp":"1791280655","comment":"","sharing_group_id":"0","deleted":false,"disable_correlation":false,"object_id":"1","object_relation":"md5","first_seen":"2026-03-02T08:30:00.000000+00:00","last_seen":null,"value":"8ba35251cca8daa4a05331bba8f95b05","Galaxy":[],"ShadowAttribute":[]},{"id":"3","type":"sha1","category":"Payload delivery","to_ids":true,"uuid":"8dd04696-9ebe-4db6-9623-7d5a3fa78d4c","event_id":"1","distribution":"5","timestamp":"1791280656","comment":"","sharing_group_id":"0","deleted":false,"disable_correlation":false,"object_id":"1","object_relation":"sha1","first_seen":"2026-03-02T08:30:00.000000+00:00","last_seen":null,"value":"4911bfb2fa8f76909de149299ef05e6b1455ea24","Galaxy":[],"ShadowAttribute":[]},{"id":"4","type":"sha256","category":"Payload delivery","to_ids":true,"uuid":"10df7a9a-9019-4d9e-9ca7-f2b392c6f8fc","event_id":"1","distribution":"5","timestamp":"1791280656","comment":"","sharing_group_id":"0","deleted":false,"disable_correlation":false,"object_id":"1","object_relation":"sha256","first_seen":"2026-03-02T08:30:00.000000+00:00","last_seen":null,"value":"2d10d13c3f3a045dc12a48e0a484018c053d0e83c607f2796fc9b8307c0d66e5","Galaxy":[],"ShadowAttribute":[]},{"id":"5","type":"size-in-bytes","category":"Other","to_ids":false,"uuid":"0b76e9b4-9d14-41c0-afb8-e2b427fe21fe","event_id":"1","distribution":"5","timestamp":"1791280656","comment":"","sharing_group_id":"0","deleted":false,"disable_correlation":true,"object_id":"1","object_relation":"size-in-bytes","first_seen":"2026-03-02T08:30:00.000000+00:00","last_seen":null,"value":"68242","Galaxy":[],"ShadowAttribute":[]}]},{"id":"2","name":"file","meta-category":"file","description":"File object describing a file with meta-information","template_uuid":"688c46fb-5edb-40a3-8273-1af7923e2215","template_version":"25","event_id":"1","uuid":"4c5d1074-f6ec-4bb8-bada-0e7b58404ab2","timestamp":"1791642247","distribution":"5","sharing_group_id":"0","comment":"BIN-02 — svchost_update.exe. Charge téléchargée par BIN-01, récupérée sur le poste comptabilite-07. Exécutable Windows PE 64 bits, empaqueté (UPX modifié). Verdict de la fiche : malveillant — balise de commande et contrôle. Sources : 01_fiches_analyse_binaires.md et indicateurs 4 à 6 de 02_indicateurs_40.csv. Cotes fournies : SHA-256 A1, SHA-1 A1, MD5 A2.","deleted":false,"first_seen":"2026-03-02T08:41:00.000000+00:00","last_seen":null,"ObjectReference":[{"id":"3","uuid":"fc351c91-25bc-4037-8293-31fcc7f3a97b","timestamp":"1791397973","object_id":"2","referenced_uuid":"8e851271-31c6-428f-b1f3-f0516921704d","referenced_id":"17","referenced_type":"0","relationship_type":"","comment":"BIN-02 utilise api-telemetry-eu.test pour ses communications de commande et contrôle. Sources : fiche BIN-02 et indicateur 14.","deleted":false,"event_id":"1","source_uuid":"4c5d1074-f6ec-4bb8-bada-0e7b58404ab2","Attribute":{"distribution":"5","sharing_group_id":"0","uuid":"8e851271-31c6-428f-b1f3-f0516921704d","value":"api-telemetry-eu.test","type":"domain","category":"Network activity","to_ids":false}},{"id":"6","uuid":"cfb7e97b-b901-4146-8364-aa46707aaa4c","timestamp":"1791554306","object_id":"2","referenced_uuid":"b57632d3-20c4-4aab-98c1-d581b533c9e6","referenced_id":"39","referenced_type":"0","relationship_type":"","comment":"BIN-02 établit une persistance par la tâche planifiée MicrosoftEdgeUpdateTaskMachine, selon sa fiche d’analyse. Sources : 01_fiches_analyse_binaires.md, fiche BIN-02 ; 02_indicateurs_40.csv, indicateur 36 ; alerte SIEM 3 et journal Sysmon du 2 mars 2026 à 08 h 46 UTC. La création est documentée, mais la configuration complète et les exécutions ultérieures ne sont pas fournies.","deleted":false,"event_id":"1","source_uuid":"4c5d1074-f6ec-4bb8-bada-0e7b58404ab2","Attribute":{"distribution":"5","sharing_group_id":"0","uuid":"b57632d3-20c4-4aab-98c1-d581b533c9e6","value":"MicrosoftEdgeUpdateTaskMachine","type":"text","category":"Persistence mechanism","to_ids":false}},{"id":"10","uuid":"c18c2c57-4615-4331-834e-cda1e0d5c014","timestamp":"1791554860","object_id":"2","referenced_uuid":"e408f9ef-fb5e-41d1-a82e-4827776f4246","referenced_id":"45","referenced_type":"0","relationship_type":"","comment":"L’indicateur 11 décrit cette empreinte comme celle d’un module injecté par BIN-02 dans explorer.exe, observé le 4 mars 2026 à 11 h 06 UTC, avec une cote Admiralty B2. Source : 02_indicateurs_40.csv, indicateur 11. L’alerte SIEM 8 et le journal Sysmon à 11 h 05 décrivent une injection sur srv-fichiers-02, mais ne fournissent pas l’empreinte du code ni le processus responsable.","deleted":false,"event_id":"1","source_uuid":"4c5d1074-f6ec-4bb8-bada-0e7b58404ab2","Attribute":{"distribution":"5","sharing_group_id":"0","uuid":"e408f9ef-fb5e-41d1-a82e-4827776f4246","value":"8772b487de8ea8d30a7630e906afa95dcbf4a75f5915066f8b6a40d487201171","type":"sha256","category":"Payload installation","to_ids":false}}],"Attribute":[{"id":"6","type":"filename","category":"Payload delivery","to_ids":false,"uuid":"0dc672d7-09b4-4b4d-9c0c-51220a226569","event_id":"1","distribution":"5","timestamp":"1791642247","comment":"","sharing_group_id":"0","deleted":false,"disable_correlation":false,"object_id":"2","object_relation":"filename","first_seen":"2026-03-02T08:41:00.000000+00:00","last_seen":null,"value":"svchost_update.exe","Galaxy":[{"id":"49","uuid":"c4e851fa-775f-11e7-8163-b774922098cd","name":"MITRE ATT&CK Techniques","type":"mitre-attack-pattern","description":"Techniques, sub-techniques and tactics from MITRE ATT&CK (Enterprise, Mobile, PRE and ICS).","version":"20","icon":"map","namespace":"mitre","enabled":true,"local_only":false,"kill_chain_order":{"attack-Containers":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","impact"],"attack-ESXi":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact"],"attack-IaaS":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","exfiltration","impact"],"attack-Identity-Provider":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement"],"attack-Linux":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact"],"attack-Network-Devices":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact"],"attack-Office-365":["initial-access","stealth","lateral-movement"],"attack-Office-Suite":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","exfiltration","impact"],"attack-PRE":["reconnaissance","resource-development"],"attack-SaaS":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","exfiltration","impact"],"attack-Windows":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact"],"attack-macOS":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact"],"ics-attack":["initial-access","execution","persistence","privilege-escalation","evasion","discovery","lateral-movement","collection","command-and-control","inhibit-response-function","impair-process-control","impact"],"ics-attack-Control-Server":["collection"],"ics-attack-Data-Historian":["collection"],"ics-attack-Engineering-Workstation":["initial-access"],"ics-attack-Field-Controller/RTU/PLC/IED":["execution","discovery","lateral-movement","collection","inhibit-response-function","impair-process-control"],"ics-attack-Human-Machine-Interface":["collection"],"ics-attack-Input/Output-Server":["discovery"],"ics-attack-Safety-Instrumented-System/Protection-Relay":["execution","lateral-movement","inhibit-response-function","impair-process-control"],"ics-attack-Windows":["initial-access","execution","discovery","lateral-movement","collection"],"mobile-attack-Android":["initial-access","execution","persistence","privilege-escalation","defense-evasion","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact","network-effects","remote-service-effects"],"mobile-attack-iOS":["initial-access","execution","persistence","privilege-escalation","defense-evasion","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact","network-effects","remote-service-effects"],"pre-attack":["priority-definition-planning","priority-definition-direction","target-selection","technical-information-gathering","people-information-gathering","organizational-information-gathering","technical-weakness-identification","people-weakness-identification","organizational-weakness-identification","adversary-opsec","establish-&-maintain-infrastructure","persona-development","build-capabilities","test-capabilities","stage-capabilities","launch","compromise"]},"default":true,"org_id":"0","orgc_id":"0","created":"2026-10-06 08:49:30","modified":"2026-10-06 08:49:30","distribution":"3","GalaxyCluster":[{"id":"17874","uuid":"005a06c6-14bf-4118-afa0-ebcd8aebb0c9","collection_uuid":"dcb864dc-775f-11e7-9fbb-1f41b4996683","type":"mitre-attack-pattern","value":"Scheduled Task - T1053.005","tag_name":"misp-galaxy:mitre-attack-pattern=\"Scheduled Task - T1053.005\"","description":"Adversaries may abuse the Windows Task Scheduler to perform task scheduling for initial or recurring execution of malicious code. There are multiple ways to access the Task Scheduler in Windows. The [schtasks](https://attack.mitre.org/software/S0111) utility can be run directly on the command line, or the Task Scheduler can be opened through the GUI within the Administrator Tools section of the Control Panel.(Citation: Stack Overflow) In some cases, adversaries have used a .NET wrapper for the Windows Task Scheduler, and alternatively, adversaries have used the Windows netapi32 library and [Windows Management Instrumentation](https://attack.mitre.org/techniques/T1047) (WMI) to create a scheduled task. Adversaries may also utilize the Powershell Cmdlet `Invoke-CimMethod`, which leverages WMI class `PS_ScheduledTask` to create a scheduled task via an XML path.(Citation: Red Canary - Atomic Red Team)\n\nAn adversary may use Windows Task Scheduler to execute programs at system startup or on a scheduled basis for persistence. The Windows Task Scheduler can also be abused to conduct remote Execution as part of Lateral Movement and/or to run a process under the context of a specified account (such as SYSTEM). Similar to [System Binary Proxy Execution](https://attack.mitre.org/techniques/T1218), adversaries have also abused the Windows Task Scheduler to potentially mask one-time execution under signed/trusted system processes.(Citation: ProofPoint Serpent)\n\nAdversaries may also create \"hidden\" scheduled tasks (i.e. [Hide Artifacts](https://attack.mitre.org/techniques/T1564)) that may not be visible to defender tools and manual queries used to enumerate tasks. Specifically, an adversary may hide a task from `schtasks /query` and the Task Scheduler by deleting the associated Security Descriptor (SD) registry value (where deletion of this value must be completed using SYSTEM permissions).(Citation: SigmaHQ)(Citation: Tarrask scheduled task) Adversaries may also employ alternate methods to hide tasks, such as altering the metadata (e.g., `Index` value) within associated registry keys.(Citation: Defending Against Scheduled Task Attacks in Windows Environments) ","galaxy_id":"49","source":"https://github.com/mitre/cti","authors":["MITRE"],"version":"41","distribution":"3","sharing_group_id":null,"org_id":"0","orgc_id":"0","default":true,"locked":false,"extends_uuid":"","extends_version":"0","published":false,"deleted":false,"GalaxyClusterRelation":[{"SourceCluster":{"id":"17874","uuid":"005a06c6-14bf-4118-afa0-ebcd8aebb0c9","collection_uuid":"dcb864dc-775f-11e7-9fbb-1f41b4996683","type":"mitre-attack-pattern","value":"Scheduled Task - T1053.005","tag_name":"misp-galaxy:mitre-attack-pattern=\"Scheduled Task - T1053.005\"","description":"Adversaries may abuse the Windows Task Scheduler to perform task scheduling for initial or recurring execution of malicious code. There are multiple ways to access the Task Scheduler in Windows. The [schtasks](https://attack.mitre.org/software/S0111) utility can be run directly on the command line, or the Task Scheduler can be opened through the GUI within the Administrator Tools section of the Control Panel.(Citation: Stack Overflow) In some cases, adversaries have used a .NET wrapper for the Windows Task Scheduler, and alternatively, adversaries have used the Windows netapi32 library and [Windows Management Instrumentation](https://attack.mitre.org/techniques/T1047) (WMI) to create a scheduled task. Adversaries may also utilize the Powershell Cmdlet `Invoke-CimMethod`, which leverages WMI class `PS_ScheduledTask` to create a scheduled task via an XML path.(Citation: Red Canary - Atomic Red Team)\n\nAn adversary may use Windows Task Scheduler to execute programs at system startup or on a scheduled basis for persistence. The Windows Task Scheduler can also be abused to conduct remote Execution as part of Lateral Movement and/or to run a process under the context of a specified account (such as SYSTEM). Similar to [System Binary Proxy Execution](https://attack.mitre.org/techniques/T1218), adversaries have also abused the Windows Task Scheduler to potentially mask one-time execution under signed/trusted system processes.(Citation: ProofPoint Serpent)\n\nAdversaries may also create \"hidden\" scheduled tasks (i.e. [Hide Artifacts](https://attack.mitre.org/techniques/T1564)) that may not be visible to defender tools and manual queries used to enumerate tasks. Specifically, an adversary may hide a task from `schtasks /query` and the Task Scheduler by deleting the associated Security Descriptor (SD) registry value (where deletion of this value must be completed using SYSTEM permissions).(Citation: SigmaHQ)(Citation: Tarrask scheduled task) Adversaries may also employ alternate methods to hide tasks, such as altering the metadata (e.g., `Index` value) within associated registry keys.(Citation: Defending Against Scheduled Task Attacks in Windows Environments) ","galaxy_id":"49","source":"https://github.com/mitre/cti","authors":"[\"MITRE\"]","version":"41","distribution":"3","sharing_group_id":null,"org_id":"0","orgc_id":"0","default":true,"locked":false,"extends_uuid":"","extends_version":"0","published":false,"deleted":false},"id":"5007","galaxy_cluster_id":"17874","referenced_galaxy_cluster_id":"20288","referenced_galaxy_cluster_uuid":"35dd844a-b219-4e2b-a6bb-efa9a75995a9","referenced_galaxy_cluster_type":"subtechnique-of","galaxy_cluster_uuid":"005a06c6-14bf-4118-afa0-ebcd8aebb0c9","distribution":"3","sharing_group_id":null,"default":true}],"Org":{"id":"0","name":"MISP","date_created":"","date_modified":"","description":"Automatically generated MISP organisation","type":"","nationality":"Not specified","sector":"","created_by":"0","uuid":"0","contacts":"","local":true,"restricted_to_domain":[],"landingpage":null},"Orgc":{"id":"0","name":"MISP","date_created":"","date_modified":"","description":"Automatically generated MISP organisation","type":"","nationality":"Not specified","sector":"","created_by":"0","uuid":"0","contacts":"","local":true,"restricted_to_domain":[],"landingpage":null},"TargetingClusterRelation":[{"id":"5939","galaxy_cluster_id":"18433","referenced_galaxy_cluster_id":"17874","referenced_galaxy_cluster_uuid":"005a06c6-14bf-4118-afa0-ebcd8aebb0c9","referenced_galaxy_cluster_type":"uses","galaxy_cluster_uuid":"df8eb785-70f8-4300-b444-277ba849083d","distribution":"3","sharing_group_id":null,"default":true},{"id":"5956","galaxy_cluster_id":"18434","referenced_galaxy_cluster_id":"17874","referenced_galaxy_cluster_uuid":"005a06c6-14bf-4118-afa0-ebcd8aebb0c9","referenced_galaxy_cluster_type":"uses","galaxy_cluster_uuid":"45a98f02-852f-49b2-94c0-c63207bebbbf","distribution":"3","sharing_group_id":null,"default":true},{"id":"6244","galaxy_cluster_id":"18448","referenced_galaxy_cluster_id":"17874","referenced_galaxy_cluster_uuid":"005a06c6-14bf-4118-afa0-ebcd8aebb0c9","referenced_galaxy_cluster_type":"uses","galaxy_cluster_uuid":"0257b35b-93ef-4a70-80dd-ad5258e6045b","distribution":"3","sharing_group_id":null,"default":true},{"id":"6351","galaxy_cluster_id":"18451","referenced_galaxy_cluster_id":"17874","referenced_galaxy_cluster_uuid":"005a06c6-14bf-4118-afa0-ebcd8aebb0c9","referenced_galaxy_cluster_type":"uses","galaxy_cluster_uuid":"1a0576df-df21-4775-843e-844d8a58a94b","distribution":"3","sharing_group_id":null,"default":true},{"id":"6563","galaxy_cluster_id":"18459","referenced_galaxy_cluster_id":"17874","referenced_galaxy_cluster_uuid":"005a06c6-14bf-4118-afa0-ebcd8aebb0c9","referenced_galaxy_cluster_type":"uses","galaxy_cluster_uuid":"93c23946-49af-41f4-ac03-40f9ffc7419b","distribution":"3","sharing_group_id":null,"default":true},{"id":"6622","galaxy_cluster_id":"18462","referenced_galaxy_cluster_id":"17874","referenced_galaxy_cluster_uuid":"005a06c6-14bf-4118-afa0-ebcd8aebb0c9","reference