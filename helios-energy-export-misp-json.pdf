7-46f7-a800-82bc04d58d24","referenced_id":"41","referenced_type":"0","relationship_type":"","comment":"BIN-01 écrit une valeur de persistance dans HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run, associée au nom WinTelemetry dans l’indicateur 38. Sources : 01_fiches_analyse_binaires.md, fiche BIN-01 ; 02_indicateurs_40.csv, indicateur 38. Le contenu de la valeur et son déclenchement effectif ne sont pas fournis.","deleted":false,"event_id":"1","source_uuid":"93faecd8-5b20-4627-8f2c-1f7a083a7b6b","Attribute":{"distribution":"5","sharing_group_id":"0","uuid":"da727fe0-8f47-46f7-a800-82bc04d58d24","value":"HKCU\\...\\Run\\WinTelemetry","type":"regkey","category":"Persistence mechanism","to_ids":false}},{"id":"11","uuid":"522e79db-d1dd-4b24-b22d-4e5758c10cd9","timestamp":"1791554962","object_id":"1","referenced_uuid":"c526b249-57fa-4a3e-bcf5-d63cb6bcd620","referenced_id":"44","referenced_type":"0","relationship_type":"","comment":"L’indicateur 10 décrit cette empreinte comme celle de la charge PowerShell déchiffrée en mémoire par BIN-01, observée le 2 mars 2026 à 08 h 32 UTC, avec une cote Admiralty B2. Source : 02_indicateurs_40.csv, indicateur 10. La fiche BIN-01 décrit le déchiffrement d’une charge et le lancement de PowerShell ; aucune capture mémoire n’est fournie pour vérifier cette empreinte.","deleted":false,"event_id":"1","source_uuid":"93faecd8-5b20-4627-8f2c-1f7a083a7b6b","Attribute":{"distribution":"5","sharing_group_id":"0","uuid":"c526b249-57fa-4a3e-bcf5-d63cb6bcd620","value":"81aa487933bb715f9dabd1755eff6cfd13a9c635e1b3bc4adff3ccbc78b8660f","type":"sha256","category":"Payload delivery","to_ids":false}},{"id":"12","uuid":"a3afa5e8-33dc-42c8-8398-c56e19eced1f","timestamp":"1791644699","object_id":"1","referenced_uuid":"7a83b952-9050-440a-b5b5-1ca0c52f4e20","referenced_id":"16","referenced_type":"0","relationship_type":"","comment":"Selon la fiche BIN-01, PowerShell télécharge la seconde charge BIN-02 depuis cdn-svc-update.test. Sources : 01_fiches_analyse_binaires.md, fiches BIN-01 et BIN-02 ; 02_indicateurs_40.csv, indicateur 13 ; alerte SIEM 2 et journal Squid du 2 mars 2026 à 08 h 42 UTC. Le téléchargement est documenté, mais le journal ne fournit pas l’empreinte du fichier transféré.","deleted":false,"event_id":"1","source_uuid":"93faecd8-5b20-4627-8f2c-1f7a083a7b6b","Attribute":{"distribution":"5","sharing_group_id":"0","uuid":"7a83b952-9050-440a-b5b5-1ca0c52f4e20","value":"cdn-svc-update.test","type":"domain","category":"Network activity","to_ids":false}}],"Attribute":[{"id":"1","type":"filename","category":"Payload delivery","to_ids":false,"uuid":"fc6ad2d1-0ed6-4e39-ab41-f70413ce9ab1","event_id":"1","distribution":"5","timestamp":"1791557894","comment":"","sharing_group_id":"0","deleted":false,"disable_correlation":false,"object_id":"1","object_relation":"filename","first_seen":"2026-03-02T08:30:00.000000+00:00","last_seen":null,"value":"facture_mars_2026.xlsm","Galaxy":[{"id":"49","uuid":"c4e851fa-775f-11e7-8163-b774922098cd","name":"MITRE ATT&CK Techniques","type":"mitre-attack-pattern","description":"Techniques, sub-techniques and tactics from MITRE ATT&CK (Enterprise, Mobile, PRE and ICS).","version":"20","icon":"map","namespace":"mitre","enabled":true,"local_only":false,"kill_chain_order":{"attack-Containers":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","impact"],"attack-ESXi":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact"],"attack-IaaS":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","exfiltration","impact"],"attack-Identity-Provider":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement"],"attack-Linux":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact"],"attack-Network-Devices":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact"],"attack-Office-365":["initial-access","stealth","lateral-movement"],"attack-Office-Suite":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","exfiltration","impact"],"attack-PRE":["reconnaissance","resource-development"],"attack-SaaS":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","exfiltration","impact"],"attack-Windows":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact"],"attack-macOS":["initial-access","execution","persistence","privilege-escalation","stealth","defense-impairment","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact"],"ics-attack":["initial-access","execution","persistence","privilege-escalation","evasion","discovery","lateral-movement","collection","command-and-control","inhibit-response-function","impair-process-control","impact"],"ics-attack-Control-Server":["collection"],"ics-attack-Data-Historian":["collection"],"ics-attack-Engineering-Workstation":["initial-access"],"ics-attack-Field-Controller/RTU/PLC/IED":["execution","discovery","lateral-movement","collection","inhibit-response-function","impair-process-control"],"ics-attack-Human-Machine-Interface":["collection"],"ics-attack-Input/Output-Server":["discovery"],"ics-attack-Safety-Instrumented-System/Protection-Relay":["execution","lateral-movement","inhibit-response-function","impair-process-control"],"ics-attack-Windows":["initial-access","execution","discovery","lateral-movement","collection"],"mobile-attack-Android":["initial-access","execution","persistence","privilege-escalation","defense-evasion","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact","network-effects","remote-service-effects"],"mobile-attack-iOS":["initial-access","execution","persistence","privilege-escalation","defense-evasion","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact","network-effects","remote-service-effects"],"pre-attack":["priority-definition-planning","priority-definition-direction","target-selection","technical-information-gathering","people-information-gathering","organizational-information-gathering","technical-weakness-identification","people-weakness-identification","organizational-weakness-identification","adversary-opsec","establish-&-maintain-infrastructure","persona-development","build-capabilities","test-capabilities","stage-capabilities","launch","compromise"]},"default":true,"org_id":"0","orgc_id":"0","created":"2026-10-06 08:49:30","modified":"2026-10-06 08:49:30","distribution":"3","GalaxyCluster":[{"id":"18301","uuid":"970a3432-3237-47ad-bcca-7d8cbb217736","collection_uuid":"dcb864dc-775f-11e7-9fbb-1f41b4996683","type":"mitre-attack-pattern","value":"PowerShell - T1059.001","tag_name":"misp-galaxy:mitre-attack-pattern=\"PowerShell - T1059.001\"","description":"Adversaries may abuse PowerShell commands and scripts for execution. PowerShell is a powerful interactive command-line interface and scripting environment included in the Windows operating system.(Citation: TechNet PowerShell) Adversaries can use PowerShell to perform a number of actions, including discovery of information and execution of code. Examples include the <code>Start-Process</code> cmdlet which can be used to run an executable and the <code>Invoke-Command</code> cmdlet which runs a command locally or on a remote computer (though administrator permissions are required to use PowerShell to connect to remote systems).\n\nPowerShell may also be used to download and run executables from the Internet, which can be executed from disk or in memory without touching disk.\n\nA number of PowerShell-based offensive testing tools are available, including [Empire](https://attack.mitre.org/software/S0363),  [PowerSploit](https://attack.mitre.org/software/S0194), [PoshC2](https://attack.mitre.org/software/S0378), and PSAttack.(Citation: Github PSAttack)\n\nPowerShell commands/scripts can also be executed without directly invoking the <code>powershell.exe</code> binary through interfaces to PowerShell's underlying <code>System.Management.Automation</code> assembly DLL exposed through the .NET framework and Windows Common Language Interface (CLI).(Citation: Sixdub PowerPick Jan 2016)(Citation: SilentBreak Offensive PS Dec 2015)(Citation: Microsoft PSfromCsharp APR 2014)","galaxy_id":"49","source":"https://github.com/mitre/cti","authors":["MITRE"],"version":"41","distribution":"3","sharing_group_id":null,"org_id":"0","orgc_id":"0","default":true,"locked":false,"extends_uuid":"","extends_version":"0","published":false,"deleted":false,"GalaxyClusterRelation":[{"SourceCluster":{"id":"18301","uuid":"970a3432-3237-47ad-bcca-7d8cbb217736","collection_uuid":"dcb864dc-775f-11e7-9fbb-1f41b4996683","type":"mitre-attack-pattern","value":"PowerShell - T1059.001","tag_name":"misp-galaxy:mitre-attack-pattern=\"PowerShell - T1059.001\"","description":"Adversaries may abuse PowerShell commands and scripts for execution. PowerShell is a powerful interactive command-line interface and scripting environment included in the Windows operating system.(Citation: TechNet PowerShell) Adversaries can use PowerShell to perform a number of actions, including discovery of information and execution of code. Examples include the <code>Start-Process</code> cmdlet which can be used to run an executable and the <code>Invoke-Command</code> cmdlet which runs a command locally or on a remote computer (though administrator permissions are required to use PowerShell to connect to remote systems).\n\nPowerShell may also be used to download and run executables from the Internet, which can be executed from disk or in memory without touching disk.\n\nA number of PowerShell-based offensive testing tools are available, including [Empire](https://attack.mitre.org/software/S0363),  [PowerSploit](https://attack.mitre.org/software/S0194), [PoshC2](https://attack.mitre.org/software/S0378), and PSAttack.(Citation: Github PSAttack)\n\nPowerShell commands/scripts can also be executed without directly invoking the <code>powershell.exe</code> binary through interfaces to PowerShell's underlying <code>System.Management.Automation</code> assembly DLL exposed through the .NET framework and Windows Common Language Interface (CLI).(Citation: Sixdub PowerPick Jan 2016)(Citation: SilentBreak Offensive PS Dec 2015)(Citation: Microsoft PSfromCsharp APR 2014)","galaxy_id":"49","source":"https://github.com/mitre/cti","authors":"[\"MITRE\"]","version":"41","distribution":"3","sharing_group_id":null,"org_id":"0","orgc_id":"0","default":true,"locked":false,"extends_uuid":"","extends_version":"0","published":false,"deleted":false},"id":"5686","galaxy_cluster_id":"18301","referenced_galaxy_cluster_id":"20277","referenced_galaxy_cluster_uuid":"7385dfaf-6886-4229-9ecd-6fd678040830","referenced_galaxy_cluster_type":"subtechnique-of","galaxy_cluster_uuid":"970a3432-3237-47ad-bcca-7d8cbb217736","distribution":"3","sharing_group_id":null,"default":true}],"Org":{"id":"0","name":"MISP","date_created":"","date_modified":"","description":"Automaticall